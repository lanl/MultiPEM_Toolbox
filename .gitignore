# R session, batch, and analysis output
.RData*
*.RData
.Rhistory
.Rapp.history
.Ruserdata
*.Rout
*.out
*.log

# MultiPEM Docker jobs and runtime metadata
/Runfiles-Docker/results/
/Test-Docker/results/
.mpem/
.testmpem/
.mpem.status
.testmpem.status

# Generated plots. Every PDF under Runfiles/ is produced by a run deck or plot
# script; the tracked documentation PDFs live at the repo root and are
# unaffected. Rplots.pdf and profile_ll*.pdf are also caught wherever R runs.
Rplots.pdf
profile_ll*.pdf
/Runfiles/**/*.pdf

# Posterior-sample and summary dumps written during analysis (postsamp_*.txt,
# tmpi_*.txt, itmpi_*.txt, etc.). No .txt file is tracked in this repository.
*.txt

# R / Rcpp build and compiled artifacts
*.o
*.so
*.dll
*.dylib
*.rds
.Rcpp.cache/
sourceCpp-*/
*.dSYM/
*.gcda
*.gcno
core
core.*

# Local R environments and package checks
.Rproj.user/
renv/library/
renv/staging/
renv/python/
*.Rcheck/

# Editor, operating-system, and temporary files
.DS_Store
Thumbs.db
*.swp
*.swo
*.tmp
*~
